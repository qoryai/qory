{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Read"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$QORY_HARNESS_HOME/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "A": "core"
  }
}

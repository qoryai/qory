{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.ai/contracts/harness/v1/layer.schema.json",
  "title": "HarnessLayer",
  "description": "harness.yaml at the root of a layer: what the layer provides beyond its tree.",
  "type": "object",
  "required": ["apiVersion", "kind", "name"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "qory.ai/v1alpha1"},
    "kind": {"const": "HarnessLayer"},
    "name": {"type": "string", "minLength": 1},
    "variants": {
      "type": "object",
      "properties": {"default": {"type": "string", "minLength": 1}},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skills": {"type": "string", "minLength": 1},
          "agents": {"type": "string", "minLength": 1},
          "commands": {"type": "string", "minLength": 1},
          "output-styles": {"type": "string", "minLength": 1},
          "hooks": {"type": "string", "minLength": 1},
          "mcp": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

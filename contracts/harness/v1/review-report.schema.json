{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/harness/v1/review-report.schema.json",
  "title": "The review report format, version 1",
  "description": "The report.json of one reviewer of a review round: the reviewer's name, its findings and the findings it closes. Each finding is blocking or non-blocking, and has the quote, the problem, the fix, the proof and a point: one line with at least one character that is not a space. A finding that has an id repeats a finding of this reviewer from an earlier round, with its proof done again. A close has the id of a finding of this reviewer, the state fixed or dismissed, and a reason. A finding of this reviewer that the report neither repeats nor closes stays open. A report that repeats and closes one id, that repeats one id twice or closes one id twice, or that has more than 100 findings or more than 100 closes is invalid. A blocking finding has a failing check or a failing input as its proof. No text has a NUL character. qory posts the report to the findings of the work item. No object has a member this schema does not define.",
  "type": "object",
  "required": [
    "reviewer",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "reviewer": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "closes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/close"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "quote",
        "problem",
        "fix",
        "proof",
        "point"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^f[1-9][0-9]{0,8}$"
        },
        "severity": {
          "enum": [
            "blocking",
            "non-blocking"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "$ref": "#/$defs/report_text"
        },
        "problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "$ref": "#/$defs/report_text"
        },
        "fix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "$ref": "#/$defs/report_text"
        },
        "proof": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^(failing check|failing input|broken rule): [^\\s\\x00][^\\x00]*$"
        },
        "point": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S",
          "$ref": "#/$defs/line"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "$ref": "#/$defs/line"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "required": [
          "severity"
        ],
        "properties": {
          "severity": {
            "const": "blocking"
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "not": {
              "pattern": "^broken rule"
            }
          }
        }
      }
    },
    "close": {
      "type": "object",
      "required": [
        "id",
        "state",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^f[1-9][0-9]{0,8}$"
        },
        "state": {
          "enum": [
            "fixed",
            "dismissed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "$ref": "#/$defs/report_text"
        }
      }
    },
    "report_text": {
      "description": "Text that may have several lines and has no NUL character, which the findings of Qory Apiary cannot keep.",
      "type": "string",
      "pattern": "^[^\\x00]*$"
    },
    "line": {
      "description": "Text on one line: no control character (so no tab, line feed or carriage return), no U+2028 or U+2029, and no format character (Unicode category Cf) but U+200C and U+200D, the joiners of emoji. The pattern is the one of $defs line in primitives.schema.json.",
      "type": "string",
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$"
    }
  }
}

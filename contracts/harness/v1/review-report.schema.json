{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/harness/v1/review-report.schema.json",
  "title": "The review report format, version 1",
  "description": "The report.json of one reviewer of a review round: the reviewer's name and its findings. Each finding is blocking or non-blocking, and has the quote, the problem, the fix, the proof and a point: one line with at least one character that is not a space. A finding that repeats one of the round before may have its id. A blocking finding has a failing check or a failing input as its proof. No object has a member this schema does not define.",
  "type": "object",
  "required": [
    "reviewer",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "reviewer": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "quote",
        "problem",
        "fix",
        "proof",
        "point"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^f[1-9][0-9]{0,5}$"
        },
        "severity": {
          "enum": [
            "blocking",
            "non-blocking"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "fix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "proof": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^(failing check|failing input|broken rule): [^\\s]"
        },
        "point": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S",
          "$ref": "#/$defs/line"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "required": [
          "severity"
        ],
        "properties": {
          "severity": {
            "const": "blocking"
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "not": {
              "pattern": "^broken rule"
            }
          }
        }
      }
    },
    "line": {
      "description": "Text on one line: no control character (so no tab, line feed or carriage return), no U+2028 or U+2029, and no format character (Unicode category Cf) but U+200C and U+200D, the joiners of emoji. The pattern is the one of $defs line in primitives.schema.json.",
      "type": "string",
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$"
    }
  }
}

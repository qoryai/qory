{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.ai/contracts/harness/v1/profile.schema.json",
  "title": "HarnessProfile",
  "description": "harness-compose.yaml: the ordered layers a harness is composed from.",
  "type": "object",
  "required": ["apiVersion", "kind", "layers"],
  "additionalProperties": false,
  "oneOf": [
    {"required": ["target"], "not": {"required": ["extends"]}},
    {"required": ["extends"], "not": {"required": ["target"]}}
  ],
  "properties": {
    "apiVersion": {"const": "qory.ai/v1alpha1"},
    "kind": {"const": "HarnessProfile"},
    "name": {"type": "string", "minLength": 1},
    "extends": {
      "description": "The base profile this one appends to: a directory holding a harness-compose.yaml.",
      "$ref": "#/$defs/source"
    },
    "target": {
      "type": "object",
      "required": ["runtime"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "description": "One runtime name, or the list of runtimes to compose for at once.",
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "model": {"type": "string", "minLength": 1}
      }
    },
    "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}},
    "extensions": {
      "description": "Values qory carries into the report and does not read: one object per namespace.",
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "extending": {
      "description": "On a base profile, what a layer of an extending profile may ship.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds": {"type": "array", "items": {"type": "string", "enum": ["skills", "agents", "commands", "output-styles"]}},
        "instructions": {"type": "boolean"},
        "settings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "layer": {
      "type": "object",
      "anyOf": [{"required": ["name"]}, {"required": ["source"]}],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "exclude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {"$ref": "#/$defs/names"},
            "agents": {"$ref": "#/$defs/names"},
            "commands": {"$ref": "#/$defs/names"},
            "output-styles": {"$ref": "#/$defs/names"},
            "hooks": {"$ref": "#/$defs/names"},
            "mcp": {"$ref": "#/$defs/names"}
          }
        },
        "variant": {"type": "string", "minLength": 1},
        "link": {
          "description": "A name at the checkout root that links to the layer's directory.",
          "type": "string",
          "pattern": "^[^./\\\\@][^/\\\\@]*$"
        }
      }
    },
    "source": {
      "description": "A directory, or a git repository at a ref with the layer's directory inside it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["path"], "not": {"anyOf": [{"required": ["git"]}, {"required": ["ref"]}]}},
        {"required": ["git", "ref"]}
      ]
    }
  }
}

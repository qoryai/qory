{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.ai/contracts/harness/v1/stack.schema.json",
  "title": "qory-stack.yaml",
  "description": "qory-stack.yaml: the ordered modules a harness is composed from, and the runtime it is rendered for.",
  "type": "object",
  "required": ["apiVersion", "target", "modules"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "qory.ai/v1alpha1"},
    "qory": {
      "description": "The qory versions this document is written for: one or more comparators, >=0.3.0 <0.4.0 say; every one has to hold.",
      "type": "string",
      "pattern": "^\\s*(>=|<=|>|<|=)v?\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\s+(>=|<=|>|<|=)v?\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?)*\\s*$"
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "target": {
      "type": "object",
      "required": ["runtime"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "description": "One runtime name, or the list of runtimes to compose for at once.",
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "model": {"type": "string", "minLength": 1}
      }
    },
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}},
    "extensions": {
      "description": "Values qory carries into the report and does not read: one object per namespace.",
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "extending": {
      "description": "What a module of a checkout extending this stack may ship.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds": {"type": "array", "items": {"type": "string", "enum": ["skills", "agents", "commands", "output-styles"]}},
        "instructions": {"type": "boolean"},
        "settings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "files": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "someNames": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "part": {
      "description": "A merged part: true for all of it, or the names of some of it.",
      "oneOf": [{"const": true}, {"$ref": "#/$defs/someNames"}]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "skills": {"$ref": "#/$defs/someNames"},
        "agents": {"$ref": "#/$defs/someNames"},
        "commands": {"$ref": "#/$defs/someNames"},
        "output-styles": {"$ref": "#/$defs/someNames"},
        "hooks": {"$ref": "#/$defs/someNames"},
        "mcp": {"$ref": "#/$defs/someNames"},
        "files": {"$ref": "#/$defs/someNames"},
        "instructions": {"const": true},
        "settings": {"$ref": "#/$defs/part"},
        "env": {"$ref": "#/$defs/part"}
      }
    },
    "module": {
      "type": "object",
      "anyOf": [{"required": ["name"]}, {"required": ["source"]}],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "exclude": {
          "description": "What of the module the compose leaves out; everything else is composed. Not with only.",
          "$ref": "#/$defs/selection"
        },
        "only": {
          "description": "The only things of the module the compose takes; everything not named is left out. Not with exclude.",
          "$ref": "#/$defs/selection"
        },
        "variant": {"type": "string", "minLength": 1},
        "link": {
          "description": "A name at the checkout root that links to the module's directory.",
          "type": "string",
          "pattern": "^[^./\\\\@][^/\\\\@]*$"
        }
      }
    },
    "source": {
      "description": "A directory, or a git repository at a ref with the module's directory inside it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["path"], "not": {"anyOf": [{"required": ["git"]}, {"required": ["ref"]}]}},
        {"required": ["git", "ref"]}
      ]
    }
  }
}

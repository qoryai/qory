{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/harness/v1/config.schema.json",
  "title": "qory.yaml, or harness.yaml",
  "description": "qory.yaml, or under its second name harness.yaml: the repository's own document at the checkout root, and the machine's in the user's directory and the checkout's ancestors. Every key is optional, apiVersion too: a file leaving it out is read as qory.dev/v1alpha1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"description": "Optional; the newest format this qory reads when left out.", "const": "qory.dev/v1alpha1"},
    "qory": {
      "description": "The qory versions this document is written for: one or more comparators, >=0.3.0 <0.4.0 say; every one has to hold.",
      "type": "string",
      "pattern": "^\\s*(>=|<=|>|<|=)v?\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\s+(>=|<=|>|<|=)v?\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?)*\\s*$"
    },
    "harness": {
      "description": "The machine's choices for a compose, and in a checkout's file its document: the checkout's own stack, a target and modules, or the stack it extends and the modules it appends. A document may leave extends out when qory harness compose -f <stack> names the base, and a document that extends a stack may name no modules, carrying its extensions alone.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          ]
        },
        "model": {"type": "string", "minLength": 1},
        "force": {"type": "boolean"},
        "update": {"type": "string", "enum": ["always", "never"]},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "extends": {
          "description": "The stack this checkout extends: a directory holding a qory-stack.yaml, or a stack the repository exports, named by stack. Left out when qory harness compose -f <stack> names the base.",
          "$ref": "#/$defs/base"
        },
        "target": {
          "description": "The runtime and model of this checkout's own stack; a section that extends a stack leaves it out and takes the base's.",
          "type": "object",
          "required": ["runtime"],
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              ]
            },
            "model": {"type": "string", "minLength": 1}
          }
        },
        "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}},
        "extensions": {
          "description": "Values qory carries into the report and does not read: one object per namespace.",
          "type": "object",
          "additionalProperties": {"type": "object"}
        }
      },
      "dependentRequired": {"target": ["modules"]},
      "not": {"required": ["extends", "target"]}
    },
    "worktree": {
      "description": "What a worktree of the repository needs, and where the machine puts it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {"type": "string", "minLength": 1},
        "name": {"type": "string", "pattern": "\\{branch\\}"},
        "base": {"type": "string", "minLength": 1},
        "branch": {"enum": ["delete", "keep"]},
        "link": {"$ref": "#/$defs/paths"},
        "copy": {"$ref": "#/$defs/paths"},
        "run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": {"$ref": "#/$defs/names"},
            "remove": {"$ref": "#/$defs/names"}
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {"type": "string", "minLength": 1},
        "cache": {"type": "string", "minLength": 1}
      }
    },
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "exports": {
      "description": "What this repository publishes for other repositories, by name: each stack at <dir>/stacks/<name>/qory-stack.yaml, each module at <dir>/modules/<name>/qory-module.yaml, dir being the repository root unless set.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "dir": {
          "description": "Where the exports are, relative to the repository root: one directory holding stacks/ and modules/, or a map naming the stacks and the modules directories as they are.",
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["stacks", "modules"],
              "properties": {
                "stacks": {"type": "string", "minLength": 1},
                "modules": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "stacks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exportName"}},
        "modules": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exportName"}}
      }
    }
  },
  "$defs": {
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "paths": {
      "description": "Paths brought into a new worktree: each a path inside the checkout, or {from, to} with from a path anywhere, absolute or under ~, and to the path in the worktree, required when from is outside the checkout.",
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["from"],
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1}
            },
            "if": {"properties": {"from": {"pattern": "^[/~]"}}},
            "then": {"required": ["to"]}
          }
        ]
      }
    },
    "module": {
      "type": "object",
      "anyOf": [{"required": ["name"]}, {"required": ["source"]}],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "exclude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {"$ref": "#/$defs/names"},
            "agents": {"$ref": "#/$defs/names"},
            "commands": {"$ref": "#/$defs/names"},
            "output-styles": {"$ref": "#/$defs/names"},
            "hooks": {"$ref": "#/$defs/names"},
            "mcp": {"$ref": "#/$defs/names"},
            "files": {"$ref": "#/$defs/names"}
          }
        },
        "variant": {"type": "string", "minLength": 1},
        "link": {
          "description": "A name at the checkout root that links to the module's directory.",
          "type": "string",
          "pattern": "^[^./\\\\@][^/\\\\@]*$"
        }
      }
    },
    "source": {
      "description": "A directory; a git repository at a ref with the module's directory inside it; or a module the repository exports, named by module, with path or git and ref naming the repository.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "module": {"$ref": "#/$defs/exportName"}
      },
      "oneOf": [
        {"required": ["path"], "not": {"anyOf": [{"required": ["git"]}, {"required": ["ref"]}]}},
        {"required": ["git", "ref"], "not": {"required": ["path", "module"]}}
      ]
    },
    "base": {
      "description": "A directory holding a qory-stack.yaml; a git repository at a ref with that directory inside it; or a stack the repository exports, named by stack, with path or git and ref naming the repository.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "stack": {"$ref": "#/$defs/exportName"}
      },
      "oneOf": [
        {"required": ["path"], "not": {"anyOf": [{"required": ["git"]}, {"required": ["ref"]}]}},
        {"required": ["git", "ref"], "not": {"required": ["path", "stack"]}}
      ]
    },
    "exportName": {
      "description": "The name of an export, one path segment.",
      "type": "string",
      "pattern": "^[^./\\\\@][^/\\\\@]*$"
    }
  }
}

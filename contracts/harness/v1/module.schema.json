{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/harness/v1/module.schema.json",
  "title": "qory-module.yaml",
  "description": "qory-module.yaml at the root of a module: its name, its variants and the variables it exports.",
  "type": "object",
  "required": ["apiVersion", "name"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "qory.dev/v1alpha1"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "env": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "egress": {
      "description": "The hosts the module's skills, hooks and servers reach: a lower-case host name, or a *. suffix matching every host below it. No ports, no paths, no schemes. The grammar is the Forager contract's policy egress.allow, https://qory.dev/contracts/forager/v1/policy.schema.json, copied here, with the rule Forager holds a policy's hosts to beside it: a host whose last label is all digits, or 0x followed by hex digits or none, is an IPv4 address in canonical form. An empty list declares that the module reaches nothing.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
        "anyOf": [
          {"pattern": "^\\*\\."},
          {"not": {"pattern": "(^|\\.)(0x[0-9a-f]*|[0-9]+)$"}},
          {"pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$"}
        ]
      }
    },
    "roles": {
      "description": "The roles the module's documents reference, by kind and then by role, each set to one: one entry fills the role.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {"$ref": "#/$defs/roleCounts"},
        "commands": {"$ref": "#/$defs/roleCounts"},
        "skills": {"$ref": "#/$defs/roleCounts"}
      }
    },
    "provides": {
      "description": "The roles the module fills, by kind and then by role, each to the name of one entry of that kind. A provided role fills a reference such as ${qory:agents/developer} unless the checkout's bind sets the role.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {"$ref": "#/$defs/roleNames"},
        "commands": {"$ref": "#/$defs/roleNames"},
        "skills": {"$ref": "#/$defs/roleNames"}
      }
    },
    "requires": {
      "description": "One item per entry of this module that needs other entries composed beside it: the entry by its singular kind, what it needs under the plural kinds, from any module.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 2,
        "properties": {
          "skill": {"type": "string", "minLength": 1},
          "agent": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "output-style": {"type": "string", "minLength": 1},
          "hook": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "mcp": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            ]
          },
          "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "agents": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "output-styles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "hooks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "push_checks": {
      "description": "Checks for the files of an artifact type, one per type across the composed modules. Optional: a module without the key adds none.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "command"],
        "additionalProperties": false,
        "properties": {
          "type": {"description": "An artifact type: lowercase letters and digits in groups joined by single hyphens, 1 to 64 bytes.", "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "command": {
            "description": "The program, a relative path inside the module with no .. part, then its arguments.",
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {"type": "string", "minLength": 1, "pattern": "^[^/]", "not": {"pattern": "(^|/)\\.\\.(/|$)"}}
            ],
            "items": {"type": "string"}
          },
          "reads": {
            "description": "The other artifact types the check reads, each once.",
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
          }
        }
      }
    },
    "variants": {
      "type": "object",
      "properties": {"default": {"type": "string", "minLength": 1}},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skills": {"type": "string", "minLength": 1},
          "agents": {"type": "string", "minLength": 1},
          "commands": {"type": "string", "minLength": 1},
          "output-styles": {"type": "string", "minLength": 1},
          "hooks": {"type": "string", "minLength": 1},
          "mcp": {"type": "string", "minLength": 1},
          "files": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "roleCounts": {
      "type": "object",
      "propertyNames": {"pattern": "^[^/\\\\@ .][^/\\\\@ ]*$"},
      "additionalProperties": {"const": "one"}
    },
    "roleNames": {
      "type": "object",
      "propertyNames": {"pattern": "^[^/\\\\@ .][^/\\\\@ ]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[^/\\\\@ .][^/\\\\@ ]*$"}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/harness/v1/primitives.schema.json",
  "title": "The primitives of the harness contracts, version 1",
  "description": "The definitions that the schemas of artifact types refer to for a line, a title, a text, a reference and a link. Each is under $defs, and each $ref in this file is to $defs of this file. A schema that refers to a primitive names this file's $id, such as https://qory.dev/contracts/harness/v1/primitives.schema.json#/$defs/title.",
  "$defs": {
    "line": {
      "description": "One line of text: no control character, no U+2028 or U+2029, and no Cf character but U+200C and U+200D (emoji joiners).",
      "type": "string",
      "pattern": "^[^\u0000-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$"
    },
    "title": {
      "description": "One line of text, 1 to 256 characters, not only spaces and joiners.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "allOf": [
        {
          "$ref": "#/$defs/line"
        },
        {
          "description": "A title has a character other than spaces and joiners (U+200C, U+200D).",
          "pattern": "[^ \u00a0\u1680\u2000-\u200a\u202f\u205f\u3000\u200c\u200d]"
        }
      ]
    },
    "text": {
      "description": "Markdown. Of the control characters it has only tab, line feed and carriage return, and it has no U+2028, U+2029 or Cf character but U+200C and U+200D.",
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^\u0000-\b\u000b\f\u000e-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$",
      "not": {
        "pattern": "(^|\\n)<!-- qory:(start|end) -->"
      }
    },
    "reference": {
      "description": "An object in a system: a collection, and its address when it has one.",
      "type": "object",
      "required": [
        "collection"
      ],
      "additionalProperties": false,
      "properties": {
        "collection": {
          "type": "string",
          "$ref": "#/$defs/line",
          "minLength": 1,
          "maxLength": 200
        },
        "address": {
          "type": "object",
          "required": [
            "system",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "system": {
              "type": "string",
              "pattern": "^[a-z0-9.-]{1,253}$"
            },
            "path": {
              "type": "string",
              "$ref": "#/$defs/line",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "link": {
      "description": "An https URL, at most 2048 characters, as RFC 3986 writes a URI: https://, a host, a port when one is written, then a path, a query and a fragment, each optional. The host is a name of letters, digits, the characters -._~!$&'()*+,;=, the percent-encodings %80 to %FF in either case, and %25, or an IPv6 address in brackets as RFC 3986 writes one, and only a port, a path, a query or a fragment follows the closing bracket; no user information comes before the host. A colon after the host may stand alone, or be followed by a port of at most 5 digits whose value is from 1 to 65535, leading zeros allowed. Every % starts a percent-encoding, % and two hexadecimal digits, and the URL contains no character outside RFC 3986's.",
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://(?:(?:[A-Za-z0-9._~!$&'()*+,;=-]|%(?:25|[89A-Fa-f][0-9A-Fa-f]))+|\\[(?:(?:[0-9A-Fa-f]{1,4}:){6}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|::(?:[0-9A-Fa-f]{1,4}:){5}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){4}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,1}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){3}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,2}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){2}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,4}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,5}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,6}[0-9A-Fa-f]{1,4})?::)\\])(?::(?:0{0,4}[1-9]|0{0,3}[1-9][0-9]|0{0,2}[1-9][0-9]{2}|0?[1-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])?)?(?:/(?:[A-Za-z0-9._~!$&'()*+,;=:@/-]|%[0-9A-Fa-f]{2})*)?(?:\\?(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})*)?(?:#(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})*)?$"
    }
  }
}

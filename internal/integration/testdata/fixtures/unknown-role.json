{
  "version": 1,
  "name": "acme-tracker",
  "title": "Acme tracker",
  "description": "A token for a run's project on the Acme tracker.",
  "program_version": "0.2.0",
  "settings": {
    "type": "object",
    "additionalProperties": false,
    "required": ["url", "token_file"],
    "properties": {
      "url": {"type": "string"},
      "token_file": {"type": "string"},
      "token": {"type": "string", "writeOnly": true}
    }
  },
  "roles": {
    "credential": {"argument": "[A-Z]+", "hosts": ["tracker.acme.example"]},
    "example_role": {}
  }
}

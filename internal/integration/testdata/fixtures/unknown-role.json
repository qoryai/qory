{
  "version": 1,
  "name": "acme-tracker",
  "title": "Acme tracker",
  "description": "Issues of the Acme tracker: a token for a run's project, and the issues as work.",
  "program_version": "0.2.0",
  "settings": {
    "type": "object",
    "additionalProperties": false,
    "required": ["url", "token_file"],
    "properties": {
      "url": {"type": "string"},
      "token_file": {"type": "string"},
      "token": {"type": "string", "writeOnly": true}
    }
  },
  "roles": {
    "credential": {"argument": "[A-Z]+", "hosts": ["tracker.acme.example"]},
    "work_source": {"events": ["issue.opened"]}
  }
}
